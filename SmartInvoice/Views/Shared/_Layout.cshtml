@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    string Active(string c, string? a = null) => controller == c && (a is null || action == a) ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · SmartInvoice</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=Newsreader:opsz,wght@6..72,500;6..72,600&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<div class="shell">
    <aside class="rail">
        <a class="wordmark" asp-controller="Home" asp-action="Index">Smart<span>Invoice</span></a>
        <nav class="rail-nav">
            <a class="@Active("Home")" asp-controller="Home" asp-action="Index"><i class="bi bi-grid-1x2"></i> Overview</a>
            <a class="@Active("Invoices", "Index") @Active("Invoices", "Details")" asp-controller="Invoices" asp-action="Index"><i class="bi bi-receipt"></i> Invoices</a>
            <a class="@Active("Invoices", "Create")" asp-controller="Invoices" asp-action="Create"><i class="bi bi-plus-circle"></i> New invoice</a>
            <a asp-controller="Invoices" asp-action="Export"><i class="bi bi-download"></i> Export CSV</a>
        </nav>
        <div class="rail-foot">All amounts in AED<br />VAT checked at 5%</div>
    </aside>

    <main class="stage">
        @if (TempData["Toast"] is string toast)
        {
            <div class="toast-line" role="status">
                <i class="bi bi-check2-circle"></i> <span>@toast</span>
                <button type="button" class="toast-close" aria-label="Dismiss" onclick="this.parentElement.remove()"><i class="bi bi-x-lg"></i></button>
            </div>
        }
        @RenderBody()
    </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
